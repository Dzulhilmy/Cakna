n_ref":{"surah":71,"ayah_from":28,"ayah_to":28},"arabic":null,"meaning_ms":null,"meaning_en":null,"tajweed":[]},{"kind":"hadith","position":1,"title_ms":"Sebelum makan","title_en":"Before eating","arabic":"بِسْمِ اللَّهِ","quran_ref":null,"meaning_ms":"Dengan nama Allah. Jika terlupa di awal: بِسْمِ اللَّهِ أَوَّلَهُ وَآخِرَهُ (Dengan nama Allah pada awal dan akhirnya).","meaning_en":"In the name of Allah. If forgotten at the start: in the name of Allah at its beginning and its end.","tajweed":[]},{"kind":"hadith","position":2,"title_ms":"Selepas makan","title_en":"After eating","arabic":"الْحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنَا وَسَقَانَا وَجَعَلَنَا مُسْلِمِينَ","quran_ref":null,"meaning_ms":"Segala puji bagi Allah yang memberi kami makan dan minum serta menjadikan kami orang Islam.","meaning_en":"All praise is due to Allah who fed us, gave us drink and made us Muslims.","tajweed":[24,1,9,28,2,7]},{"kind":"hadith","position":3,"title_ms":"Sebelum tidur","title_en":"Before sleeping","arabic":"بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا","quran_ref":null,"meaning_ms":"Dengan nama-Mu ya Allah aku mati dan aku hidup.","meaning_en":"In Your name, O Allah, I die and I live.","tajweed":[17,3,0]},{"kind":"hadith","position":4,"title_ms":"Bangun tidur","title_en":"Upon waking","arabic":"الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ","quran_ref":null,"meaning_ms":"Segala puji bagi Allah yang menghidupkan kami selepas mematikan kami, dan kepada-Nya kebangkitan.","meaning_en":"All praise is due to Allah who gave us life after death, and to Him is the resurrection.","tajweed":[24,1,9,46,1,9,72,3,0]},{"kind":"hadith","position":5,"title_ms":"Masuk tandas","title_en":"Entering the toilet","arabic":"اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْخُبُثِ وَالْخَبَائِثِ","quran_ref":null,"meaning_ms":"Ya Allah, aku berlindung dengan-Mu daripada syaitan jantan dan betina. (Melangkah kaki kiri dahulu.)","meaning_en":"O Allah, I seek refuge in You from male and female devils. (Enter with the left foot.)","tajweed":[7,3,0,13,3,0,16,1,9,48,3,10,55,3,8]},{"kind":"hadith","position":6,"title_ms":"Keluar tandas","title_en":"Leaving the toilet","arabic":"غُفْرَانَكَ","quran_ref":null,"meaning_ms":"Aku memohon keampunan-Mu. (Melangkah kaki kanan dahulu.)","meaning_en":"I ask for Your forgiveness. (Exit with the right foot.)","tajweed":[]},{"kind":"hadith","position":7,"title_ms":"Keluar rumah","title_en":"Leaving home","arabic":"بِسْمِ اللَّهِ، تَوَكَّلْتُ عَلَى اللَّهِ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ","quran_ref":null,"meaning_ms":"Dengan nama Allah, aku bertawakal kepada Allah; tiada daya dan kekuatan melainkan dengan Allah.","meaning_en":"In the name of Allah, I place my trust in Allah; there is no power nor strength except with Allah.","tajweed":[]},{"kind":"hadith","position":8,"title_ms":"Masuk rumah","title_en":"Entering home","arabic":"بِسْمِ اللَّهِ وَلَجْنَا، وَبِسْمِ اللَّهِ خَرَجْنَا، وَعَلَى اللَّهِ رَبِّنَا تَوَكَّلْنَا","quran_ref":null,"meaning_ms":"Dengan nama Allah kami masuk, dengan nama Allah kami keluar, dan kepada Allah Tuhan kami, kami bertawakal. (Kemudian beri salam kepada ahli keluarga.)","meaning_en":"In Allah's name we enter, in Allah's name we leave, and upon Allah our Lord we rely. (Then greet your family.)","tajweed":[19,2,7,47,2,7]},{"kind":"hadith","position":9,"title_ms":"Menaiki kenderaan","title_en":"Boarding a vehicle","arabic":null,"quran_ref":{"surah":43,"ayah_from":13,"ayah_to":14},"meaning_ms":null,"meaning_en":null,"tajweed":[]},{"kind":"hadith","position":10,"title_ms":"Doa untuk ibu bapa","title_en":"For one's parents","arabic":null,"quran_ref":{"surah":17,"ayah_from":24,"ayah_to":24},"meaning_ms":null,"meaning_en":null,"tajweed":[]},{"kind":"hadith","position":11,"title_ms":"Masuk masjid","title_en":"Entering the mosque","arabic":"اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ","quran_ref":null,"meaning_ms":"Ya Allah, bukakanlah untukku pintu-pintu rahmat-Mu. (Melangkah kaki kanan dahulu.)","meaning_en":"O Allah, open for me the doors of Your mercy. (Enter with the right foot.)","tajweed":[7,3,0,21,1,9,25,2,7]},{"kind":"hadith","position":12,"title_ms":"Keluar masjid","title_en":"Leaving the mosque","arabic":"اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ","quran_ref":null,"meaning_ms":"Ya Allah, aku memohon kepada-Mu daripada kurniaan-Mu.","meaning_en":"O Allah, I ask You of Your bounty.","tajweed":[7,3,0,13,3,0,16,1,9,31,2,1,34,2,1]},{"kind":"hadith","position":13,"title_ms":"Selepas azan","title_en":"After the adhan","arabic":"اللَّهُمَّ رَبَّ هَٰذِهِ الدَّعْوَةِ التَّامَّةِ، وَالصَّلَاةِ الْقَائِمَةِ، آتِ مُحَمَّدًا الْوَسِيلَةَ وَالْفَضِيلَةَ، وَابْعَثْهُ مَقَامًا مَحْمُودًا الَّذِي وَعَدْتَهُ","quran_ref":null,"meaning_ms":"Ya Allah, Tuhan seruan yang sempurna ini dan solat yang didirikan, kurniakanlah kepada Nabi Muhammad wasilah dan kelebihan, dan bangkitkanlah baginda pada kedudukan terpuji yang telah Engkau janjikan.","meaning_en":"O Allah, Lord of this perfect call and established prayer, grant Muhammad the wasilah and distinction, and raise him to the praised station You have promised him.","tajweed":[7,3,0,43,3,0,68,3,8,85,3,0,107,3,10,123,3,10,138,2,2,142,2,2,165,2,7]},{"kind":"hadith","position":14,"title_ms":"Penerang hati (sebelum belajar)","title_en":"Opening the heart (before study)","arabic":null,"quran_ref":{"surah":20,"ayah_from":25,"ayah_to":28},"meaning_ms":null,"meaning_en":null,"tajweed":[]},{"kind":"hadith","position":15,"title_ms":"Menuntut ilmu","title_en":"Seeking knowledge","arabic":"رَبِّ زِدْنِي عِلْمًا","quran_ref":null,"meaning_ms":"Tuhanku, tambahkanlah ilmuku. (Taha 20:114)","meaning_en":"My Lord, increase me in knowledge. (Taha 20:114)","tajweed":[8,2,7]},{"kind":"hadith","position":16,"title_ms":"Ketika hujan","title_en":"When it rains","arabic":"اللَّهُمَّ صَيِّبًا نَافِعًا","quran_ref":null,"meaning_ms":"Ya Allah, jadikanlah hujan ini hujan yang bermanfaat.","meaning_en":"O Allah, make it a beneficial rain.","tajweed":[7,3,0,16,2,2,20,2,2]}]