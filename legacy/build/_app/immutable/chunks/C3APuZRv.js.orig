var e={qaris:[{id:`ar.alafasy`,name:`Mishary Alafasy`},{id:`ar.abdulbasitmurattal`,name:`Abdul Basit`},{id:`ar.husary`,name:`Al-Husary`}],rule_names:[`Ghunnah`,`Ikhfa' Hakiki`,`Idgham Ma'al Ghunnah`,`Idgham Bila Ghunnah`,`Iqlab`,`Ikhfa' Syafawi`,`Idgham Mithlain`,`Qalqalah`,`Madd Wajib Muttasil`,`Madd Jaiz Munfasil`,`Madd Lazim`],tj_chips:[`نّ`,`نْ ت`,`ن ي`,`ن ر`,`ن ب`,`مْ ب`,`مْ م`,`قْ`,`اءَ`,`ا أ`,`اقّ`],tj_desc:{ms:[`Nun atau mim bersabdu — dengung sempurna 2 harakat.`,`Nun mati / tanwin bertemu 15 huruf ikhfa' — sembunyikan bacaan dengan dengung.`,`Nun mati / tanwin bertemu ي ن م و — masukkan dengan dengung.`,`Nun mati / tanwin bertemu ل ر — masukkan tanpa dengung.`,`Nun mati / tanwin bertemu ب — tukar kepada mim dengan dengung.`,`Mim mati bertemu ب — sembunyikan pada bibir dengan dengung.`,`Mim mati bertemu م — masukkan dengan dengung.`,`Huruf ق ط ب ج د bertanda mati atau diwaqafkan — bacaan melantun.`,`Madd bertemu hamzah dalam kalimah yang sama — 4 hingga 5 harakat.`,`Madd di hujung kalimah bertemu hamzah di kalimah berikutnya — 2, 4 atau 5 harakat.`,`Madd bertemu sabdu atau tanda mati — 6 harakat.`],en:[`Noon or meem with shaddah — full nasalisation of 2 counts.`,`Silent noon / tanween before the 15 ikhfa' letters — conceal with nasalisation.`,`Silent noon / tanween before ي ن م و — merge with nasalisation.`,`Silent noon / tanween before ل ر — merge without nasalisation.`,`Silent noon / tanween before ب — convert to meem with nasalisation.`,`Silent meem before ب — conceal at the lips with nasalisation.`,`Silent meem before م — merge with nasalisation.`,`The letters ق ط ب ج د with sukoon or at a stop — echoing sound.`,`Madd followed by hamzah within the same word — 4 to 5 counts.`,`Madd at a word's end followed by hamzah in the next word — 2, 4 or 5 counts.`,`Madd followed by shaddah or sukoon — 6 counts.`]},pz_types:{u:[`Tidak puasa (uzur)`,`Missed (excused)`],q:[`Puasa ganti (qada)`,`Make-up fast (qada)`],s:[`Puasa sunat`,`Voluntary fast`],r:[`Puasa Ramadan`,`Ramadan fast`]},pz_reasons:{haid:[`Haid`,`Menses`],nifas:[`Nifas`,`Post-natal`],sakit:[`Sakit`,`Illness`],musafir:[`Musafir`,`Travel`],hamil:[`Hamil / menyusu`,`Pregnant / nursing`],lain:[`Lain-lain`,`Other`]},data_keys:[`settings`,`bookmarks`,`notes`,`hls`,`read`,`readlog`,`khatamToasted`,`tasbih`,`city`,`sgdays`,`onboarded`,`mathurat`,`mgquiz`,`puasa`,`manasik`]};function t(e,t,n=!0){if(!n||!t||t.length===0||!e)return[{text:e,rule:null}];let r=[],i=0;for(let n=0;n+2<t.length+1;n+=3){let a=t[n],o=t[n+1],s=t[n+2];a<i||(a>i&&r.push({text:e.slice(i,a),rule:null}),r.push({text:e.slice(a,a+o),rule:s}),i=a+o)}return i<e.length&&r.push({text:e.slice(i),rule:null}),r}var n=e,r=n.qaris,i=n.rule_names,a=n.tj_chips,o=n.tj_desc,s=n.pz_types,c=n.pz_reasons;function l(e){if(!e)return[];let t=[];for(let n=2;n<e.length;n+=3)t.includes(e[n])||t.push(e[n]);return t}export{a,t as c,i,s as n,o,r,l as s,c as t};