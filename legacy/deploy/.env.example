# ─────────────────────────────────────────────────────────────────────────────
# Cakna DEPLOY configuration — consumed by docker-compose in THIS directory.
# Copy to `.env` and fill in:   cp .env.example .env
#
# NOTE: this is the DEPLOYMENT env file. It is SEPARATE from server/.env
# (which is only read when running the Node app directly, outside Docker).
# ─────────────────────────────────────────────────────────────────────────────

# Public domain for the app. Caddy auto-provisions a Let's Encrypt cert for it.
# A DNS A record for this name must already point at the instance's public IP.
DOMAIN=cakna.example.com

# Password for the bundled `postgres` service (and the app's DATABASE_URL).
# Use a long random value, e.g.  openssl rand -base64 24
# Keep it simple: no spaces, quotes, or a literal '@' (it goes into a URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── QCXIS SSO (OpenID Connect) ───────────────────────────────────────────────
# Register a CONFIDENTIAL app at https://qcxis.com -> Console -> Settings -> SSO apps.
# The redirect URI must be registered EXACTLY as below (https + your domain).
QCXIS_CLIENT_ID=
QCXIS_CLIENT_SECRET=
QCXIS_REDIRECT_URI=https://cakna.example.com/auth/sso/callback
QCXIS_ISSUER=https://qcxis.com

# Comma-separated emails allowed into /admin (in addition to the users.is_admin
# flag). e.g.  ADMIN_EMAILS=you@qcxis.com,ops@qcxis.com
ADMIN_EMAILS=

# Seed ~10 demo users + reading progress so the /admin dashboard has live data.
# 1 = seed on first boot (default). 0 = skip. (Only runs during the one-time init.)
SEED_DEMO=1

# Secure cookies. Keep 1 for HTTPS (production). Set 0 ONLY for HTTP/IP-only
# testing via the ":80" block in the Caddyfile (Secure cookies need HTTPS).
COOKIE_SECURE=1

# ── Managed database (AWS RDS) — optional ────────────────────────────────────
# Only when pointing at an external Postgres instead of the bundled container
# (see the "RDS alternative" section in DEPLOY-EC2.md). Uncomment and set PGSSL=1;
# also override DATABASE_URL in docker-compose.yml to your RDS endpoint with
# ?sslmode=require appended.
# PGSSL=1
