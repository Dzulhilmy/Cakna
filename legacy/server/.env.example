# QCXIS SSO — register a CONFIDENTIAL app at https://qcxis.com → Console → Settings → SSO apps
# Redirect URI to register (exact match): http://localhost:3000/auth/sso/callback
# Scopes: openid profile email offline_access
QCXIS_CLIENT_ID=
QCXIS_CLIENT_SECRET=
# optional overrides:
# QCXIS_ISSUER=https://qcxis.com
# QCXIS_REDIRECT_URI=http://localhost:3000/auth/sso/callback

# Comma-separated emails allowed into /admin (in addition to users.is_admin). e.g. admin@qcxis.com
ADMIN_EMAILS=
