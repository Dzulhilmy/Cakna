# copy to deploy/.env on the server
#
# deploy/.env is server-only and git-ignored. Losing that box means losing these
# secrets, so keep a copy somewhere safe.

# ── Core ─────────────────────────────────────────────────────────────────────
DB_PASSWORD=change-me

# Public hostname for the app. Caddy provisions its certificate automatically.
DOMAIN=cakna.qcxis.com

# Comma-separated emails granted admin, in addition to the users.is_admin flag.
# A fresh deployment has NO admin until this is set — see "Bootstrapping the
# first admin" in the root README.
ADMIN_EMAILS=

# ── QCXIS SSO (optional) ─────────────────────────────────────────────────────
# Leave blank to disable; the login page then offers email/password only.
QCXIS_CLIENT_ID=
QCXIS_CLIENT_SECRET=
QCXIS_ISSUER=https://qcxis.com
# Must match the URI registered with QCXIS exactly.
QCXIS_REDIRECT_URI=https://cakna.qcxis.com/auth/sso/callback

# ── Halaqah audio / LiveKit ──────────────────────────────────────────────────
# Full setup — DNS, firewall ports, verification — is in LIVEKIT-DEPLOY.md.
#
# Generate:  key    = openssl rand -hex 16
#            secret = openssl rand -hex 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Its own hostname, with its own DNS A record pointing at this server.
LIVEKIT_DOMAIN=live.cakna.qcxis.com

# What the BROWSER connects to. Must be wss:// — a page served over HTTPS cannot
# open an insecure ws:// socket, and the room fails with
# "could not establish signal connection".
LIVEKIT_URL=wss://live.cakna.qcxis.com

# Server-to-server, stays local. LiveKit uses host networking, so the API
# container reaches it via the host gateway rather than by service name.
LIVEKIT_API_URL=http://host.docker.internal:7880

# ── Cakna Hub (optional) ─────────────────────────────────────────────────────
# Internal URL of the hub-server. Leave blank to disable hub proxy endpoints
# (/api/hub/site and /api/hub/programs). When docker-compose.hub.yml is active
# alongside this file, set this to the hub-server's internal Docker hostname:
HUB_URL=http://hub-server:3002
# Must match HUB_INTERNAL_SECRET in hub-server's environment (docker-compose.hub.yml).
# Generate with: openssl rand -hex 32
HUB_INTERNAL_SECRET=
